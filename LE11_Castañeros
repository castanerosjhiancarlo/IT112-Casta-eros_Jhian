#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    FILE *fp;
    int idNumber;
    char fullName[100];
    char section[50];
    int choice;

    do {
        printf("Enter Student Number: ");
        scanf("%d", &idNumber);
        getchar();

        printf("Enter Complete Name: ");
        fgets(fullName, sizeof(fullName), stdin);
        fullName[strcspn(fullName, "\n")] = '\0';

        printf("Enter Section: ");
        fgets(section, sizeof(section), stdin);
        section[strcspn(section, "\n")] = '\0';

        // Open file in append mode
        fp = fopen("student_records.txt", "a");

        if (fp == NULL) {
            printf("Error opening file!\n");
            return 1;
        }

        // Save student record
        fprintf(fp, "ID Number: %d\n", idNumber);
        fprintf(fp, "Complete Name: %s\n", fullName);
        fprintf(fp, "Section: %s\n\n", section);

        fclose(fp);

        printf("\nRecord added and saved successfully.\n");

        printf("\nAdd another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);
        printf("\n");

    } while (choice == 1);

    printf("All student records have been saved.\n");

    // Read and display saved student records
    fp = fopen("student_records.txt", "r");

    if (fp == NULL) {
        printf("Error reading file!\n");
        return 1;
    }

    printf("\n===== SAVED STUDENT RECORDS =====\n\n");

    char line[200];

    while (fgets(line, sizeof(line), fp) != NULL) {
        printf("%s", line);
    }

    fclose(fp);

    return 0;
}
